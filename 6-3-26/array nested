class Solution {
    public int arrayNesting(int[] nums) {
        int n = nums.length;
        int maxLen = 0;

        for (int i = 0; i < n; i++) {
            if (nums[i] != -1) {
                int start = i;
                int count = 0;

                while (nums[start] != -1) {
                    int temp = nums[start];
                    nums[start] = -1; // mark visited
                    start = temp;
                    count++;
                }

                maxLen = Math.max(maxLen, count);
            }
        }

        return maxLen;
    }
}
