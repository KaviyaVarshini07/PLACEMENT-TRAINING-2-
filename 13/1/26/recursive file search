import java.io.File;

public class FileSearch {
    public static void search(File dir, String keyword) {
        for (File file : dir.listFiles()) {
            if (file.isDirectory()) search(file, keyword);
            else if (file.getName().contains(keyword)) System.out.println("Found: " + file.getAbsolutePath());
        }
    }
    public static void main(String[] args) {
        search(new File("."), "Demo");
    }
}
