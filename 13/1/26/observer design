import java.util.*;

interface Observer { void update(String msg); }
class Subject {
    private List<Observer> observers = new ArrayList<>();
    void addObserver(Observer o) { observers.add(o); }
    void notifyObservers(String msg) { observers.forEach(o -> o.update(msg)); }
}
class ConcreteObserver implements Observer {
    private String name;
    ConcreteObserver(String n) { name = n; }
    public void update(String msg) { System.out.println(name + " received: " + msg); }
}

public class ObserverDemo {
    public static void main(String[] args) {
        Subject subject = new Subject();
        subject.addObserver(new ConcreteObserver("Observer1"));
        subject.addObserver(new ConcreteObserver("Observer2"));
        subject.notifyObservers("Event Triggered!");
    }
}
