import random

responses = {
    "hi": "Hello! How can I help you?",
    "bye": "Goodbye!",
    "how are you": "I'm just code, but I'm doing great!"
}

while True:
    user = input("You: ").lower()
    if user in responses:
        print("Bot:", responses[user])
    else:
        print("Bot:", random.choice(["Interesting...", "Tell me more!", "Hmm..."]))
