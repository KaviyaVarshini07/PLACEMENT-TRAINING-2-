class Resource {
    synchronized void methodA(Resource r) {
        System.out.println("Thread " + Thread.currentThread().getName() + " locked methodA");
        try { Thread.sleep(100); } catch(Exception e) {}
        r.methodB();
    }
    synchronized void methodB() {
        System.out.println("Thread " + Thread.currentThread().getName() + " locked methodB");
    }
}

public class DeadlockDemo {
    public static void main(String[] args) {
        Resource r1 = new Resource();
        Resource r2 = new Resource();

        Thread t1 = new Thread(() -> r1.methodA(r2), "T1");
        Thread t2 = new Thread(() -> r2.methodA(r1), "T2");

        t1.start();
        t2.start();
    }
}
