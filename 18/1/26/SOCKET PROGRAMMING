import socket

server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
server.bind(("localhost", 9999))
server.listen(1)
print("Server listening...")

conn, addr = server.accept()
print("Connected:", addr)

while True:
    msg = conn.recv(1024).decode()
    if msg == "quit": break
    print("Client:", msg)
    conn.send(input("Server: ").encode())

conn.close()
