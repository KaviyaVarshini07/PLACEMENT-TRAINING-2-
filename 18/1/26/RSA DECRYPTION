import random

def gcd(a,b):
    while b: a,b = b,a%b
    return a

def modinv(a,m):
    for x in range(1,m):
        if (a*x)%m==1: return x

p,q = 61,53
n = p*q
phi = (p-1)*(q-1)
e = 17
d = modinv(e,phi)

msg = 42
cipher = pow(msg,e,n)
plain = pow(cipher,d,n)

print("Cipher:", cipher, "Plain:", plain)
