import turtle

def draw_branch(t, length):
    if length < 10:
        return
    t.forward(length)
    t.left(30)
    draw_branch(t, length-10)
    t.right(60)
    draw_branch(t, length-10)
    t.left(30)
    t.backward(length)

screen = turtle.Screen()
t = turtle.Turtle()
t.left(90)
draw_branch(t, 60)
screen.mainloop()
