import hashlib

class Block:
    def __init__(self, data, prev_hash="0"):
        self.data = data
        self.prev_hash = prev_hash
        self.hash = self.calc_hash()

    def calc_hash(self):
        return hashlib.sha256((self.data+self.prev_hash).encode()).hexdigest()

