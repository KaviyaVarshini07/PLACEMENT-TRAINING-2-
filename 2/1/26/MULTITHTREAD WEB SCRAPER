import requests
import threading

def fetch_url(url):
    response = requests.get(url)
    print(f"{url}: {len(response.text)} characters")

urls = ["https://example.com", "https://python.org", "https://github.com"]
threads = []

for url in urls:
    t = threading.Thread(target=fetch_url, args=(url,))
    threads.append(t)
    t.start()

for t in threads:
    t.join()
